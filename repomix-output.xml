                                                          Text(
                                                            info.namespace.isNotEmpty
                                                                ? "${info.namespace} • ${info.provider.isNotEmpty ? info.provider : info.rawId}"
                                                                : (info.provider.isNotEmpty
                                                                    ? info.provider
                                                                    : info.rawId),
                                                            style: TextStyle(
                                                              fontSize: 11,
                                                              color: HermesTokens.textMuted,
                                                            ),
                                                            maxLines: 1,
                                                            overflow: TextOverflow.ellipsis,
