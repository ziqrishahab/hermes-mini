void main() {
  TestWidgetsFlutterBinding.ensureInitialized();

  group('StorageService Onboarding', () {
    setUp(() {
      SharedPreferences.setMockInitialValues({});
    });

    test('isOnboardingCompleted defaults to false', () async {
      final storage = StorageService();
      final completed = await storage.isOnboardingCompleted();
      expect(completed, isFalse);
    });

    test('setOnboardingCompleted persists true', () async {
      final storage = StorageService();
      await storage.setOnboardingCompleted(true);
      final completed = await storage.isOnboardingCompleted();
      expect(completed, isTrue);
    });
  });

  group('OnboardingScreen Widget Tests', () {
    setUp(() {
      SharedPreferences.setMockInitialValues({});
    });

    testWidgets('renders breadcrumb info and initial controls', (tester) async {
      await tester.pumpWidget(
        const ProviderScope(
          child: MaterialApp(
            home: OnboardingScreen(),
          ),
        ),
      );
      await tester.pumpAndSettle();

      expect(find.text('Device Setup'), findsOneWidget);
      expect(find.text('Accessibility Permission'), findsOneWidget);
      expect(find.text('Enable Hermes Accessibility Service'), findsOneWidget);
