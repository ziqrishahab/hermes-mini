/// Helper for authentic Neumorphic dual shadows and debossed wells
class NeumorphicDecoration {
  /// Extruded / Raised surface (cards, buttons, containers)
  static BoxDecoration raised({
    double radius = HermesTokens.radiusMd,
    Color? color,
    double distance = 5.0,
    double blur = 10.0,
    Border? border,
    bool? isDark,
  }) {
    final dark = isDark ?? HermesTokens.isDark;
    final bg = color ?? (dark ? HermesColors.dark.bgSecondary : HermesColors.light.bgSecondary);
    final shadowLight = dark ? HermesColors.dark.neuShadowLight : HermesColors.light.neuShadowLight;
    final shadowDark = dark ? HermesColors.dark.neuShadowDark : HermesColors.light.neuShadowDark;
    final borderDef = border ?? Border.all(
      color: dark ? HermesColors.dark.borderBright : HermesColors.light.borderBright,
      width: 0.8,
    );

    return BoxDecoration(
      color: bg,
      borderRadius: BorderRadius.circular(radius),
      border: borderDef,
      boxShadow: [
        BoxShadow(
          color: shadowLight,
          offset: Offset(-distance, -distance),
          blurRadius: blur,
        ),
        BoxShadow(
          color: shadowDark,
          offset: Offset(distance, distance),
          blurRadius: blur,
        ),
      ],
    );
  }

  /// Recessed / Inset / Debossed surface (text inputs, search bars, toggle tracks)
  static BoxDecoration recessed({
    double radius = HermesTokens.radiusSm,
    Color? color,
    Border? border,
    bool? isDark,
  }) {
    final dark = isDark ?? HermesTokens.isDark;
    final bg = color ?? (dark ? HermesColors.dark.bgTertiary : HermesColors.light.bgTertiary);
    final borderDef = border ?? Border.all(
      color: dark ? const Color(0x26FFFFFF) : const Color(0x1F94A3B8),
      width: 1.0,
    );

    return BoxDecoration(
      color: bg,
      borderRadius: BorderRadius.circular(radius),
      border: borderDef,
      boxShadow: dark
          ? [
              const BoxShadow(
                color: Color(0x80000000),
                offset: Offset(1.5, 1.5),
                blurRadius: 3,
              ),
              const BoxShadow(
                color: Color(0x0FFFFFFF),
                offset: Offset(-1, -1),
                blurRadius: 2,
              ),
            ]
          : [
              const BoxShadow(
                color: Color(0x2E94A3B8),
                offset: Offset(1.5, 1.5),
                blurRadius: 3,
              ),
              const BoxShadow(
                color: Colors.white,
                offset: Offset(-1, -1),
                blurRadius: 2,
              ),
            ],
    );
  }

  /// Circular raised icon button or avatar
  static BoxDecoration circle({
    Color? color,
    double distance = 4.0,
    double blur = 8.0,
    Border? border,
    bool? isDark,
  }) {
    final dark = isDark ?? HermesTokens.isDark;
    final bg = color ?? (dark ? HermesColors.dark.bgSecondary : HermesColors.light.bgSecondary);
    final shadowLight = dark ? HermesColors.dark.neuShadowLight : HermesColors.light.neuShadowLight;
    final shadowDark = dark ? HermesColors.dark.neuShadowDark : HermesColors.light.neuShadowDark;
    final borderDef = border ?? Border.all(
      color: dark ? HermesColors.dark.borderBright : HermesColors.light.borderBright,
      width: 0.8,
    );

    return BoxDecoration(
      borderRadius: BorderRadius.circular(999),
      color: bg,
      border: borderDef,
      boxShadow: [
        BoxShadow(
          color: shadowLight,
          offset: Offset(-distance, -distance),
          blurRadius: blur,
        ),
        BoxShadow(
          color: shadowDark,
          offset: Offset(distance, distance),
          blurRadius: blur,
        ),
      ],
    );
  }

  /// Tactile Neumorphic Switcher / Segment Indicator Thumb
  static BoxDecoration switcherThumb({
    double radius = 16.0,
    bool? isDark,
  }) {
    final dark = isDark ?? HermesTokens.isDark;
    return dark
        ? BoxDecoration(
            gradient: const LinearGradient(
              begin: Alignment.topLeft,
              end: Alignment.bottomRight,
              colors: [
                Color(0xFF222831),
                Color(0xFF161A21),
              ],
            ),
            borderRadius: BorderRadius.circular(radius),
            border: Border.all(
              color: const Color(0x1CFFFFFF),
              width: 0.8,
            ),
            boxShadow: const [
              BoxShadow(
                color: Color(0x12FFFFFF),
                offset: Offset(-1.5, -1.5),
                blurRadius: 3,
              ),
              BoxShadow(
                color: Color(0x99000000),
                offset: Offset(2, 3),
                blurRadius: 5,
              ),
            ],
          )
        : BoxDecoration(
            gradient: const LinearGradient(
              begin: Alignment.topLeft,
              end: Alignment.bottomRight,
              colors: [
                Color(0xFFEDF2F7),
                Color(0xFFD6DFEB),
              ],
            ),
            borderRadius: BorderRadius.circular(radius),
            border: Border.all(
              color: const Color(0x80FFFFFF),
              width: 0.8,
            ),
            boxShadow: const [
              BoxShadow(
                color: Color(0xB3FFFFFF),
                offset: Offset(-2, -2),
                blurRadius: 4,
              ),
              BoxShadow(
                color: Color(0x2E8B9BB0),
                offset: Offset(2, 3),
                blurRadius: 5,
              ),
            ],
          );
  }

  /// Context-aware raised decoration
  static BoxDecoration of(
    BuildContext context, {
    double radius = HermesTokens.radiusMd,
    Color? color,
    double distance = 5.0,
    double blur = 10.0,
    Border? border,
  }) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    return raised(
      radius: radius,
      color: color,
      distance: distance,
      blur: blur,
      border: border,
      isDark: isDark,
    );
  }
}

