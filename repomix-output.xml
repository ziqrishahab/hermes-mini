<file path="lib/src/ui/screens/onboarding_screen.dart">
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:go_router/go_router.dart';

import '../../providers/theme_provider.dart';
import '../../services/accessibility_service.dart';
import '../../services/storage_service.dart';
import '../../theme.dart';

class OnboardingScreen extends ConsumerStatefulWidget {
  const OnboardingScreen({super.key});

  @override
  ConsumerState<OnboardingScreen> createState() => _OnboardingScreenState();
}

class _OnboardingScreenState extends ConsumerState<OnboardingScreen>
    with WidgetsBindingObserver {
  bool _isServiceEnabled = false;
  bool _isChecking = true;
  final StorageService _storageService = StorageService();

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addObserver(this);
    _checkServiceStatus();
  }

  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this);
    super.dispose();
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    if (state == AppLifecycleState.resumed) {
      _checkServiceStatus();
    }
  }

  Future<void> _checkServiceStatus() async {
    setState(() => _isChecking = true);
    final enabled = await AccessibilityService.isEnabled();
    if (!mounted) return;

    if (enabled && !_isServiceEnabled) {
      HapticFeedback.lightImpact();
    }

    setState(() {
      _isServiceEnabled = enabled;
      _isChecking = false;
    });
  }

  Future<void> _handleOpenSettings() async {
    HapticFeedback.selectionClick();
    await AccessibilityService.openSettings();
  }

  Future<void> _handleProceed() async {
    HapticFeedback.mediumImpact();
    await _storageService.setOnboardingCompleted(true);
    if (!mounted) return;
    context.go('/connect');
  }

  Future<void> _handleSkip() async {
    HapticFeedback.selectionClick();
    await _storageService.setOnboardingCompleted(true);
    if (!mounted) return;
    context.go('/connect');
  }

  @override
  Widget build(BuildContext context) {
    final isDark = ref.watch(isDarkProvider);

    return AnnotatedRegion<SystemUiOverlayStyle>(
      value: SystemUiOverlayStyle(
        statusBarColor: Colors.transparent,
        statusBarIconBrightness: isDark ? Brightness.light : Brightness.dark,
        statusBarBrightness: isDark ? Brightness.dark : Brightness.light,
        systemNavigationBarColor: HermesTokens.bgPrimary,
        systemNavigationBarIconBrightness: isDark ? Brightness.light : Brightness.dark,
      ),
      child: Scaffold(
        backgroundColor: HermesTokens.bgPrimary,
        body: SafeArea(
          child: Column(
            children: [
              _buildBreadcrumbHeader(),
              Expanded(
                child: SingleChildScrollView(
                  physics: const BouncingScrollPhysics(),
                  padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 16),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      _buildHeaderSection(),
                      const SizedBox(height: 20),
                      if (!_isServiceEnabled) ...[
                        _buildExplanationCard(),
                        const SizedBox(height: 16),
                        _buildInstructionsCard(),
                      ] else ...[
                        _buildVerifiedCard(),
                      ],
                    ],
                  ),
                ),
              ),
              _buildBottomActionSection(),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildBreadcrumbHeader() {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 14),
      decoration: BoxDecoration(
        color: HermesTokens.bgPrimary,
        border: Border(
          bottom: BorderSide(
            color: HermesTokens.divider.withValues(alpha: 0.4),
            width: 1,
          ),
        ),
      ),
      child: Row(
        children: [
          Text(
            'Device Setup',
            style: TextStyle(
              fontSize: 12,
              fontWeight: FontWeight.w500,
              color: HermesTokens.textMuted,
            ),
          ),
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 8),
            child: Text(
              '/',
              style: TextStyle(
                fontSize: 12,
                color: HermesTokens.textMuted.withValues(alpha: 0.5),
              ),
            ),
          ),
          Text(
            _isServiceEnabled ? 'Accessibility Granted' : 'Accessibility Permission',
            style: TextStyle(
              fontSize: 12,
              fontWeight: _isServiceEnabled ? FontWeight.w500 : FontWeight.w700,
              color: _isServiceEnabled ? HermesTokens.textMuted : HermesTokens.accent,
            ),
          ),
          if (_isServiceEnabled) ...[
            Padding(
              padding: const EdgeInsets.symmetric(horizontal: 8),
              child: Text(
                '/',
                style: TextStyle(
                  fontSize: 12,
                  color: HermesTokens.textMuted.withValues(alpha: 0.5),
                ),
              ),
            ),
            Text(
              'Remote Connection',
              style: TextStyle(
                fontSize: 12,
                fontWeight: FontWeight.w700,
                color: HermesTokens.accent,
              ),
            ),
          ],
        ],
      ),
    );
  }

  Widget _buildHeaderSection() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(
          _isServiceEnabled
              ? 'Device Ready for Automation'
              : 'Enable Hermes Accessibility Service',
          style: TextStyle(
            fontSize: 22,
            fontWeight: FontWeight.w800,
            color: HermesTokens.textPrimary,
            letterSpacing: -0.4,
          ),
        ),
        const SizedBox(height: 8),
        Text(
          _isServiceEnabled
              ? 'Accessibility Service is active. Hermes Agent can now execute local device gestures and interface actions safely.'
              : 'Allow Hermes to perform tap, swipe, and input gestures on your Android device when instructed by your agent.',
          style: TextStyle(
            fontSize: 13,
            height: 1.5,
            color: HermesTokens.textSecondary,
          ),
        ),
      ],
    );
  }

  Widget _buildExplanationCard() {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(18),
      decoration: NeumorphicDecoration.raised(
        radius: 16,
        distance: 4,
        blur: 10,
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            'Why is this required?',
            style: TextStyle(
              fontSize: 14,
              fontWeight: FontWeight.w700,
              color: HermesTokens.textPrimary,
            ),
          ),
          const SizedBox(height: 10),
          _buildInfoRow(
            title: 'Autonomous Device Actions',
            detail: 'Enables Hermes to click elements, fill forms, and interact with apps according to your prompt.',
          ),
          const SizedBox(height: 12),
          _buildInfoRow(
            title: 'Local and Private',
            detail: 'Runs directly on your Android system without transmitting screen data or keystrokes to third parties.',
          ),
          const SizedBox(height: 12),
          _buildInfoRow(
            title: 'Always Revocable',
            detail: 'You maintain full control and can turn off the service at any time in Android Accessibility Settings.',
          ),
        ],
      ),
    );
  }

  Widget _buildInfoRow({
    required String title,
    required String detail,
  }) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(
          title,
          style: TextStyle(
            fontSize: 12,
            fontWeight: FontWeight.w600,
            color: HermesTokens.textPrimary,
          ),
        ),
        const SizedBox(height: 2),
        Text(
          detail,
          style: TextStyle(
            fontSize: 11,
            height: 1.4,
            color: HermesTokens.textMuted,
          ),
        ),
      ],
    );
  }

  Widget _buildInstructionsCard() {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(18),
      decoration: NeumorphicDecoration.raised(
        radius: 16,
        distance: 4,
        blur: 10,
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            'Activation Steps',
            style: TextStyle(
              fontSize: 14,
              fontWeight: FontWeight.w700,
              color: HermesTokens.textPrimary,
            ),
          ),
          const SizedBox(height: 12),
          _buildInstructionStep(
            number: '1',
            text: 'Tap "Open Android Settings" below to open system settings.',
          ),
          const SizedBox(height: 10),
          _buildInstructionStep(
            number: '2',
            text: 'Find "Hermes" under Installed / Downloaded Services.',
          ),
          const SizedBox(height: 10),
          _buildInstructionStep(
            number: '3',
            text: 'Toggle the switch to On and confirm the system dialog.',
          ),
          const SizedBox(height: 10),
          _buildInstructionStep(
            number: '4',
            text: 'Return to this screen. The status will verify automatically.',
          ),
        ],
      ),
    );
  }

  Widget _buildInstructionStep({
    required String number,
    required String text,
  }) {
    return Row(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Container(
          width: 22,
          height: 22,
          alignment: Alignment.center,
          decoration: BoxDecoration(
            color: HermesTokens.accent.withValues(alpha: 0.12),
            borderRadius: BorderRadius.circular(6),
          ),
          child: Text(
            number,
            style: TextStyle(
              fontSize: 11,
              fontWeight: FontWeight.w700,
              color: HermesTokens.accent,
            ),
          ),
        ),
        const SizedBox(width: 12),
        Expanded(
          child: Text(
            text,
            style: TextStyle(
              fontSize: 12,
              height: 1.4,
              color: HermesTokens.textSecondary,
            ),
          ),
        ),
      ],
    );
  }

  Widget _buildVerifiedCard() {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(20),
      decoration: NeumorphicDecoration.raised(
        radius: 16,
        distance: 4,
        blur: 10,
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            'Accessibility Service Verified',
            style: TextStyle(
              fontSize: 15,
              fontWeight: FontWeight.w700,
              color: HermesTokens.textPrimary,
            ),
          ),
          const SizedBox(height: 8),
          Text(
            'The Android Accessibility Service is confirmed active. Hermes Daemon can now trigger touches, navigate between screens, and input text autonomously.',
            style: TextStyle(
              fontSize: 12,
              height: 1.5,
              color: HermesTokens.textSecondary,
            ),
          ),
          const SizedBox(height: 16),
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
            decoration: BoxDecoration(
              color: HermesTokens.bgSecondary.withValues(alpha: 0.5),
              borderRadius: BorderRadius.circular(10),
              border: Border.all(
                color: HermesTokens.border.withValues(alpha: 0.4),
                width: 1,
              ),
            ),
            child: Row(
              children: [
                Icon(
                  Icons.check_circle_outline_rounded,
                  size: 16,
                  color: HermesTokens.accent,
                ),
                const SizedBox(width: 10),
                Expanded(
                  child: Text(
                    'Ready for Remote Gateway Connection',
                    style: TextStyle(
                      fontSize: 11,
                      fontWeight: FontWeight.w600,
                      color: HermesTokens.textPrimary,
                    ),
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildBottomActionSection() {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 16),
      decoration: BoxDecoration(
        color: HermesTokens.bgPrimary,
        border: Border(
          top: BorderSide(
            color: HermesTokens.divider.withValues(alpha: 0.4),
            width: 1,
          ),
        ),
      ),
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          if (!_isServiceEnabled) ...[
            GestureDetector(
              onTap: _handleOpenSettings,
              child: Container(
                width: double.infinity,
                height: 50,
                decoration: BoxDecoration(
                  gradient: LinearGradient(
                    colors: [
                      HermesTokens.accent,
                      const Color(0xFF8B5CF6),
                    ],
                  ),
                  borderRadius: BorderRadius.circular(14),
                  boxShadow: [
                    BoxShadow(
                      color: HermesTokens.accent.withValues(alpha: 0.35),
                      offset: const Offset(0, 4),
                      blurRadius: 10,
                    ),
                  ],
                ),
                child: const Center(
                  child: Row(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      Icon(
                        Icons.settings_outlined,
                        color: Colors.white,
                        size: 18,
                      ),
                      SizedBox(width: 8),
                      Text(
                        'Open Android Settings',
                        style: TextStyle(
                          color: Colors.white,
                          fontSize: 14,
                          fontWeight: FontWeight.w700,
                          letterSpacing: 0.2,
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ),
            const SizedBox(height: 10),
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                GestureDetector(
                  onTap: _isChecking ? null : _checkServiceStatus,
                  child: Padding(
                    padding: const EdgeInsets.symmetric(vertical: 4),
                    child: Text(
                      _isChecking ? 'Checking status...' : 'Check Status',
                      style: TextStyle(
                        fontSize: 12,
                        fontWeight: FontWeight.w600,
                        color: HermesTokens.accent,
                      ),
                    ),
                  ),
                ),
                GestureDetector(
                  onTap: _handleSkip,
                  child: Padding(
                    padding: const EdgeInsets.symmetric(vertical: 4),
                    child: Text(
                      'Skip for now',
                      style: TextStyle(
                        fontSize: 12,
                        fontWeight: FontWeight.w500,
                        color: HermesTokens.textMuted,
