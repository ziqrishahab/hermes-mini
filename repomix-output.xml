                                                                        ? HermesTokens.success
                                                                            .withValues(alpha: 0.15)
                                                                        : HermesTokens.accent
                                                                            .withValues(alpha: 0.15),
                                                                    borderRadius: BorderRadius.circular(4),
                                                                  ),
                                                                  child: Text(
                                                                    info.tag!,
                                                                    style: TextStyle(
                                                                      fontSize: 9,
                                                                      fontWeight: FontWeight.w700,
                                                                      color: info.isFree
                                                                          ? HermesTokens.success
                                                                          : HermesTokens.accent,
                                                                      letterSpacing: 0.5,
                                                                    ),
                                                                  ),
                                                                ),
                                                              ],
                                                            ],
                                                          ),
