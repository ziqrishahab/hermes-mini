                            "Enable Gateway Bridge",
                            style: TextStyle(
                              fontSize: 13,
                              fontWeight: FontWeight.w700,
                              color: HermesTokens.textPrimary,
                            ),
                          ),
                          const SizedBox(height: 2),
                          Text(
                            _enabled
                                ? "Daemon will listen and respond on $_platformName"
