            child: Padding(
              padding: EdgeInsets.only(left: 6),
              child: Icon(
                Icons.copy_rounded,
                size: 13,
                color: HermesTokens.textMuted,
              ),
            ),
          ),
        ],
      ),
    );
  }
}
