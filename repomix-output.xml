                                                                  style: TextStyle(
                                                                    fontSize: 13,
                                                                    fontWeight: isSelected
                                                                        ? FontWeight.w700
                                                                        : FontWeight.w600,
                                                                    color: isSelected
                                                                        ? HermesTokens.accent
                                                                        : HermesTokens.textPrimary,
