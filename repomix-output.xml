                  const SizedBox(height: 14),

                  // Section count header
                  schedulesAsync.when(
                    data: (schedules) => Padding(
                      padding: const EdgeInsets.only(bottom: 2, left: 2),
                      child: Text(
                        "SCHEDULES (${schedules.length})",
                        style: TextStyle(
                          fontSize: 11,
                          fontWeight: FontWeight.w600,
                          color: HermesTokens.textMuted,
