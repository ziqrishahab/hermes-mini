import 'dart:async';
import 'remote_connection.dart';
import '../models/connection_config.dart';

// Data classes

class SkillInfo {
  final String name;
  final String category;
  final String description;
  final String path;
  final bool enabled;

  const SkillInfo({
    required this.name,
    required this.category,
    required this.description,
    required this.path,
    this.enabled = true,
  });

  factory SkillInfo.fromJson(Map<String, dynamic> json) {
    return SkillInfo(
      name: json['name'] as String? ?? '',
      category: json['category'] as String? ?? '',
      description: json['description'] as String? ?? '',
      path: json['path'] as String? ?? '',
      enabled: json['enabled'] as bool? ?? true,
    );
  }

  Map<String, dynamic> toJson() => {
        'name': name,
        'category': category,
        'description': description,
        'path': path,
        'enabled': enabled,
      };
}

class ToolsetInfo {
  final String key;
  final String label;
  final String description;
  final bool enabled;

  const ToolsetInfo({
    required this.key,
    required this.label,
    required this.description,
    this.enabled = true,
  });

  factory ToolsetInfo.fromJson(Map<String, dynamic> json) {
    final k = json['key'] as String? ?? json['name'] as String? ?? '';
    final l = json['label'] as String? ?? json['name'] as String? ?? k;
    return ToolsetInfo(
      key: k,
      label: l,
      description: json['description'] as String? ?? '',
      enabled: json['enabled'] as bool? ?? true,
    );
  }

  Map<String, dynamic> toJson() => {
        'key': key,
        'label': label,
        'description': description,
        'enabled': enabled,
      };
}

class SessionSummary {
  final String id;
  final String title;
  final String startedAt;
  final String source;
  final int messageCount;
  final String model;
  final String snippet;
  final int unreadCount;

  const SessionSummary({
    required this.id,
    required this.title,
    required this.startedAt,
    required this.source,
    required this.messageCount,
    required this.model,
    this.snippet = '',
    this.unreadCount = 0,
  });

  factory SessionSummary.fromJson(Map<String, dynamic> json) {
    String startedAtStr = '';
    final rawStarted = json['startedAt'] ?? json['started_at'];
    if (rawStarted is num) {
      startedAtStr = DateTime.fromMillisecondsSinceEpoch((rawStarted * 1000).toInt()).toIso8601String();
    } else if (rawStarted != null) {
      startedAtStr = rawStarted.toString();
    }

    int unread = 0;
    if (json['unreadCount'] is int) {
      unread = json['unreadCount'] as int;
    } else if (json['unread'] == true) {
      unread = 1;
    }

    final rawSnippet = json['last_message'] ??
        json['lastMessage'] ??
        json['last_message_content'] ??
        json['snippet'] ??
        json['preview'] ??
        '';

    return SessionSummary(
      id: json['id'] as String? ?? '',
      title: json['title'] as String? ?? 'Untitled Session',
      startedAt: startedAtStr,
      source: json['source'] as String? ?? '',
      messageCount: json['messageCount'] as int? ?? json['message_count'] as int? ?? 0,
      model: json['model'] as String? ?? '',
      snippet: rawSnippet.toString(),
      unreadCount: unread,
    );
  }

  SessionSummary copyWith({
    String? id,
    String? title,
    String? startedAt,
    String? source,
    int? messageCount,
    String? model,
    String? snippet,
    int? unreadCount,
  }) {
    return SessionSummary(
      id: id ?? this.id,
      title: title ?? this.title,
      startedAt: startedAt ?? this.startedAt,
      source: source ?? this.source,
      messageCount: messageCount ?? this.messageCount,
      model: model ?? this.model,
      snippet: snippet ?? this.snippet,
      unreadCount: unreadCount ?? this.unreadCount,
    );
  }

  Map<String, dynamic> toJson() => {
        'id': id,
        'title': title,
        'startedAt': startedAt,
        'source': source,
        'messageCount': messageCount,
        'model': model,
        'snippet': snippet,
        'unreadCount': unreadCount,
      };
}

class ModelConfig {
  final String name;
  final String provider;
  final String model;
  final String baseUrl;
  final bool enabled;
  final String? apiKeyHint;

  const ModelConfig({
    required this.name,
    required this.provider,
    required this.model,
    required this.baseUrl,
    this.enabled = true,
    this.apiKeyHint,
  });

  String get providerKey => provider;

  factory ModelConfig.fromJson(Map<String, dynamic> json) {
    return ModelConfig(
      name: json['name'] as String? ?? json['model'] as String? ?? '',
      provider: json['provider'] as String? ?? '',
      model: json['model'] as String? ?? '',
      baseUrl: json['baseUrl'] as String? ?? '',
      enabled: json['enabled'] as bool? ?? true,
      apiKeyHint: json['apiKeyHint'] as String?,
    );
  }

  Map<String, dynamic> toJson() => {
        'name': name,
        'provider': provider,
        'model': model,
        'baseUrl': baseUrl,
        'enabled': enabled,
        'apiKeyHint': apiKeyHint,
      };
}

